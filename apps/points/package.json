{
  "name": "@antseed/points",
  "private": true,
  "version": "0.1.0",
  "description": "Antseed Points: weekly ANTS points, provider boosts, staking and leaderboards",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run",
    "dev:pages": "vite build && wrangler pages dev dist --port 8788 --binding SESSION_SECRET=dev-secret-not-for-production DEV_FAKE_X=1"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "^5.94.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satori": "0.32.0",
    "viem": "^2.47.6",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
