                  "_fal_ui_field": "image"
                },
                "type": "array",
                "maxItems": 10
              },
              {
                "type": "null"
              }
            ],
            "description": "Reference images, referenced as @Image1, @Image2, ...",
            "examples": [
              null
            ]
          },
          "video_url": {
            "type": "string",
            "x-fal": {
              "min_width": 700,
              "max_aspect_ratio": 2.5,
              "min_height": 700,
              "max_width": 4553,
              "max_file_size": 314572800,
              "max_duration": 30.05,
              "max_fps": 60.05,
              "min_fps": 23.9,
              "min_duration": 3,
              "timeout": 30,
              "max_height": 4553,
              "min_aspect_ratio": 0.4
            },
