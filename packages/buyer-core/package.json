{
  "name": "@antseed/buyer-core",
  "version": "0.1.12",
  "description": "Transport-agnostic AntSeed buyer machinery: request handling, payment negotiation, channel accounting. Portable — no Node-only dependencies",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node ../../scripts/remove-paths.mjs dist",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antseed/api-adapter": "workspace:*",
    "@antseed/protocol": "workspace:*",
    "ethers": "~6.16.0",
    "tokenx": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./base-evm-client": {
      "import": "./dist/base-evm-client.js",
      "types": "./dist/base-evm-client.d.ts"
    },
    "./buyer-free-usage-manager": {
