{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antseed.network/schemas/contract-deployment-state.json",
  "title": "AntSeed contract deployment state",
  "type": "object",
  "required": ["network", "chainId", "release", "status", "sourceCommit", "transactions", "contracts"],
  "properties": {
    "$schema": { "type": "string" },
    "network": { "type": "string", "minLength": 1 },
    "chainId": { "type": "integer", "minimum": 1 },
    "release": { "type": "string", "minLength": 1 },
    "status": { "enum": ["baseline", "deployed", "active"] },
    "sourceCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "effectiveEpoch": { "type": ["integer", "null"], "minimum": 0 },
    "notes": { "type": "string" },
    "transactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transaction" }
    },
    "registryBefore": { "$ref": "#/$defs/addressMap" },
    "registryAfter": { "$ref": "#/$defs/addressMap" },
    "verificationConfiguration": { "type": "object" },
    "contracts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/contract" }
    }
  },
  "allOf": [
    {
      "$comment": "A record with known provenance describes a broadcast this repository executed, so it must list the transactions that produced it. Reconstructed legacy baselines use a null sourceCommit and are exempt.",
      "if": {
        "properties": { "sourceCommit": { "type": "string" } },
        "required": ["sourceCommit"]
      },
      "then": {
        "properties": {
          "transactions": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "$comment": "Baseline records never carry provenance.",
      "if": {
        "properties": { "status": { "const": "baseline" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "sourceCommit": { "type": "null" } }
      }
    }
  ],
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "addressMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/address" }
    },
    "transaction": {
      "type": "object",
      "required": ["action", "hash", "blockNumber", "from", "to"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "from": { "$ref": "#/$defs/address" },
        "to": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "deploymentBlock": { "type": ["integer", "null"], "minimum": 0 },
        "transactionHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "runtimeCodeHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "version": { "type": ["string", "null"] },
        "external": { "type": "boolean" },
        "deployedInRelease": { "type": "boolean" },
        "constructorArguments": { "type": ["array", "null"] },
        "owner": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "A contract created by this release must carry full provenance.",
          "if": {
            "properties": { "deployedInRelease": { "const": true } },
            "required": ["deployedInRelease"]
          },
          "then": {
            "required": [
              "deploymentBlock",
              "transactionHash",
              "runtimeCodeHash",
              "constructorArguments",
              "owner"
            ],
            "properties": {
              "deploymentBlock": { "type": "integer", "minimum": 0 },
              "transactionHash": { "$ref": "#/$defs/hash" },
              "runtimeCodeHash": { "$ref": "#/$defs/hash" },
              "constructorArguments": { "type": "array" },
              "owner": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
